# Скопируйте на сервер: cp deploy/env.production.example .env
# VITE_* нужны до npm run build

NODE_ENV=production
JWT_SECRET=замените-на-длинную-случайную-строку
API_PORT=3001
API_HOST=127.0.0.1

YANDEX_GEOCODER_API_KEY=
VITE_YANDEX_MAPS_API_KEY=

# Опционально
# NOMINATIM_CONTACT_EMAIL=you@example.com
# REVERSE_GEOCODE_TTL_DAYS=14
# VITE_API_BASE_URL=   # не задавайте, если nginx отдаёт / и /api с одного домена
