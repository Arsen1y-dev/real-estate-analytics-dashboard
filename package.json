{
  "name": "real-estate-analytics-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/index.ts",
    "dev:all": "npm run dev:api & npm run dev",
    "dev:tunnel": "TUNNEL_PROVIDER=localtunnel bash scripts/dev-with-tunnel.sh",
    "dev:tunnel:cf": "TUNNEL_PROVIDER=cloudflare bash scripts/dev-with-tunnel.sh",
    "dev:tunnel:lt": "TUNNEL_PROVIDER=localtunnel bash scripts/dev-with-tunnel.sh",
    "dev:tunnel:ngrok": "TUNNEL_PROVIDER=ngrok bash scripts/dev-with-tunnel.sh",
    "build": "vite build",
    "start:api": "tsx server/index.ts",
    "preview": "vite preview",
    "check:parser-configs": "tsx server/validateParserConfigs.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "multer": "^2.1.1",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.0",
    "@vitejs/plugin-react": "^5.0.0",
    "baseline-browser-mapping": "^2.10.16",
    "localtunnel": "^2.0.2",
    "tsx": "^4.22.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
