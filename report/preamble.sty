% Скриншот дашборда: \screenshot[ширина]{метка}{имя-файла}{подпись}
% Файл кладётся в report/images/{имя-файла}.png
\newcommand{\screenshot}[4][0.92]{%
  \begin{figure}[htbp]%
  \centering
  \IfFileExists{images/#3.png}{%
    \includegraphics[width=#1\textwidth]{#3}%
  }{%
    \fbox{%
      \begin{minipage}{#1\textwidth}%
      \centering
      \vspace{2.8cm}
      {\small\textit{Место для скриншота}}\\[0.6ex]
      {\footnotesize\ttfamily images/#3.png}\\[0.4ex]
      {\scriptsize #4}
      \vspace{2.8cm}
      \end{minipage}%
    }%
  }%
  \caption{#4}%
  \label{fig:#2}%
  \end{figure}%
}

